{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROBINWOOD",
  "version": "0.1.0",
  "identifier": "pl.robinwood.program",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROBINWOOD",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "center": true
      },
      {
        "label": "widzet",
        "title": "ROBINWOOD – widżet",
        "url": "index.html",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "visible": false,
        "x": 40,
        "y": 40
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ROBINWOOD",
    "shortDescription": "Oferty, umowy, klienci i kalendarz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Polish"],
        "installMode": "currentUser"
      }
    }
  }
}
